{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      }
    },
    "phase4b-internal": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "autoIncrement": true
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_MST_ENVIRONMENT": "production",
        "EXPO_PUBLIC_MST_SCORES_API_ORIGIN": "https://scores-api.myanmarsportstalk.com",
        "EXPO_PUBLIC_MST_APP_API_ORIGIN": "https://app-api.myanmarsportstalk.com"
      }
    }
  }
}
