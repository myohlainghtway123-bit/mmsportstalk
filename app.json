{
  "expo": {
    "name": "MST Score",
    "slug": "mst-app",
    "owner": "myohlainghtway",
    "description": "MST Score — live football scores, news, transfers, favorites and predictions by Myanmar Sports Talk.",
    "version": "1.5.2",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#07090B",
    "scheme": "mst",
    "newArchEnabled": true,
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#07090B"
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "color": "#F32735",
          "defaultChannel": "match-alerts"
        }
      ]
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.myanmarsportstalk.mst",
      "buildNumber": "12",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.myanmarsportstalk.mst",
      "versionCode": 12,
      "edgeToEdgeEnabled": true,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#07090B"
      }
    },
    "androidStatusBar": {
      "backgroundColor": "#07090B",
      "barStyle": "light-content"
    },
    "androidNavigationBar": {
      "backgroundColor": "#0D1013",
      "barStyle": "light-content"
    },
    "extra": {
      "eas": {
        "projectId": "393dcc05-f6d3-42ca-9c35-b35b5eedf090"
      }
    }
  }
}
