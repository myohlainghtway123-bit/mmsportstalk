{
  "license": "0BSD",
  "main": "index.js",
  "scripts": {
    "prepare:assets": "node scripts/generate_assets.js",
    "postinstall": "node scripts/generate_assets.js",
    "start": "node scripts/generate_assets.js && expo start",
    "android": "node scripts/generate_assets.js && expo start --android",
    "ios": "node scripts/generate_assets.js && expo start --ios",
    "web": "expo start --web",
    "validate:shared-backend": "node scripts/validate_shared_backend.js",
    "test:phase4b-api": "node --experimental-default-type=module scripts/test_phase4b_scores_api.mjs",
    "test:phase4b": "npm run test:phase4b-api && node scripts/validate_phase4b_internal_alpha.js",
    "validate:android": "node scripts/generate_assets.js && expo export --clear --platform android --output-dir dist-ci && node scripts/validate_phase4b_bundle.js",
    "build:android:phase4b": "npx eas-cli@latest build --platform android --profile phase4b-internal",
    "build:android:apk": "npx eas-cli@latest build --platform android --profile preview",
    "build:ios:internal": "npx eas-cli@latest build --platform ios --profile preview",
    "build:android:store": "npx eas-cli@latest build --platform android --profile production",
    "build:ios:store": "npx eas-cli@latest build --platform ios --profile production"
  },
  "dependencies": {
    "@expo/vector-icons": "15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~54.0.37",
    "expo-constants": "~18.0.13",
    "expo-device": "~8.0.10",
    "expo-font": "14.0.12",
    "expo-image-picker": "~17.0.11",
    "expo-notifications": "~0.32.17",
    "expo-secure-store": "~15.0.8",
    "expo-status-bar": "~3.0.9",
    "react": "19.1.0",
    "react-native": "0.81.5"
  },
  "overrides": {
    "expo-font": "14.0.12"
  },
  "private": true
}
